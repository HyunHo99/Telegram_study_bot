# ===== Telegram =====
# BotFather 에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# 벌금/공지를 보낼 단톡방 chat_id (선택).
# 비워두면 봇이 참여한 각 단톡방별로 집계/공지합니다.
ANNOUNCE_CHAT_ID=

# ===== Notion =====
# Notion Integration Internal Token (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_your_notion_token

# 아카이빙 상위 페이지 ID (하이픈 없이 32자, 또는 하이픈 포함 UUID)
# 예시 URL: https://app.notion.com/p/263d26beb4988070bcb6d46f66c32aa1
NOTION_PARENT_PAGE_ID=263d26beb4988070bcb6d46f66c32aa1

# Notion 연동을 끄려면 0 으로 설정
NOTION_ENABLED=1

# ===== 스케줄 / 시간대 =====
# 벌금 집계 요일/시간 (한국시간 기준). 기본: 월요일 08:00
TIMEZONE=Asia/Seoul

# ===== 저장소 =====
DB_PATH=data/study_bot.db

# ===== 권한 =====
# 관리자 텔레그램 user_id 목록 (쉼표 구분). 레벨 등록/변경, 수동 집계 권한.
# 비워두면 각 그룹의 관리자(admin)면 누구나 관리 명령 사용 가능.
ADMIN_USER_IDS=
